{
  "name": "equipment-checkout",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @equipment/web",
    "dev:api": "npm run dev -w @equipment/api",
    "verify": "npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
